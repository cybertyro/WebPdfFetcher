// ==UserScript==
// @name         终极唯一水印按钮（仅顶层body）
// @namespace    https://github.com/your-namespace
// @version      4.1
// @description  保证只在最顶层页面body插入唯一按钮，反复清理所有遗留
// @match        *://*/*
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    // 只在最顶层window和根body下运行
    if (window.self !== window.top) return;
    if (document.body.parentElement.tagName !== "HTML") return;

    // 防止同一页面多次插入或局部刷新
    Array.from(document.body.querySelectorAll('#watermark-toggle-btn-unique, .watermark-print-hide-btn')).forEach(el => el.remove());
    if (window.__hasWatermarkBtn__) return;
    window.__hasWatermarkBtn__ = true;

    const BUTTON_ID = "watermark-toggle-btn-unique";
    const BUTTON_CLASS = "watermark-print-hide-btn";
    // 打印时隐藏按钮
    if (!document.getElementById('add_print_hide_btn_style')) {
        const style = document.createElement('style');
        style.id = 'add_print_hide_btn_style';
        style.textContent = `
@media print {
    .${BUTTON_CLASS} { display: none !important; }
}`;
        document.head.appendChild(style);
    }
    // 覆盖水印
    const WATERMARK_STYLE_ID = 'hide-all-watermark-style';
    function injectOrRemoveWatermarkStyle(hide) {
        let style = document.getElementById(WATERMARK_STYLE_ID);
        if (hide && !style) {
            style = document.createElement('style');
            style.id = WATERMARK_STYLE_ID;
            style.textContent = `
@media screen,print {
    #page_height::after,
    body::after,
    html::after
    { background-image: none !important; content: "" !important; opacity: 0 !important; pointer-events: none !important; }
    .watermark,
    .bg-watermark,
    .water-mark
    { background-image: none !important; opacity: 0.05 !important; }
    canvas[id*="watermark"], canvas[class*="watermark"] { opacity: 0!important; pointer-events: none!important; }
}`;
            document.head.appendChild(style);
        } else if (!hide && style) {
            style.remove();
        }
    }

    // 主体和外围水印背景
    function hideContextBg() {
        [
          document.querySelector('#context'),
          document.querySelector('#page_height'),
          document.querySelector('.content_container')
        ].forEach(ctx=>{
          if (ctx) {
              ctx.setAttribute('data-old-bg', ctx.style.backgroundImage || '');
              ctx.style.backgroundImage = "none";
          }
        });
    }
    function showContextBg() {
        [
          document.querySelector('#context'),
          document.querySelector('#page_height'),
          document.querySelector('.content_container')
        ].forEach(ctx=>{
          if (ctx && ctx.hasAttribute('data-old-bg')) {
              ctx.style.backgroundImage = ctx.getAttribute('data-old-bg');
          }
        });
    }
    // 只插body
    const btn = document.createElement('button');
    btn.id = BUTTON_ID;
    btn.className = BUTTON_CLASS;
    btn.textContent = "隐藏水印";
    btn.style.position = 'fixed';
    btn.style.bottom = '40px';
    btn.style.right = '30px';
    btn.style.zIndex = 99999;
    btn.style.background = "#0aa";
    btn.style.color = "#fff";
    btn.style.border = "none";
    btn.style.borderRadius = "6px";
    btn.style.padding = "8px 14px";
    btn.style.cursor = "pointer";
    btn.style.boxShadow = "0 2px 8px rgba(0,0,0,0.15)";
    document.body.appendChild(btn);

    let hidden = false;
    // 监控保证水印一直隐藏
    const mo = new MutationObserver(() => { if (hidden) hideContextBg(); });
    mo.observe(document.body, {childList:true, subtree:true, attributes:true, attributeFilter:['style']});

    btn.onclick = function() {
        if (!hidden) {
            injectOrRemoveWatermarkStyle(true);
            hideContextBg();
            btn.textContent = "显示水印";
        } else {
            injectOrRemoveWatermarkStyle(false);
            showContextBg();
            btn.textContent = "隐藏水印";
        }
        hidden = !hidden;
    };
    window.addEventListener('beforeprint', () => { injectOrRemoveWatermarkStyle(true); hideContextBg(); });
    window.addEventListener('afterprint', () => { if (!hidden) { injectOrRemoveWatermarkStyle(false); showContextBg(); } });

})();
